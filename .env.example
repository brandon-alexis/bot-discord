TOKEN=""

# Persistencia de tareas.
# En Render, configura DATABASE_URL con la cadena de conexión de PostgreSQL.
# Si DATABASE_URL está vacío, se usa SQLite en TASK_DB_PATH.
DATABASE_URL=""
TASK_DB_PATH="data/tasks.db"

# Zona horaria para interpretar las fechas de los recordatorios.
TASK_TIMEZONE="America/Bogota"

# Cada cuántos segundos se revisan las tareas vencidas.
TASK_CHECK_INTERVAL="30"
